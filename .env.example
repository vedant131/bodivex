# Copy to .env to point the app at a hosted backend. Leave unset to use the local stack (npm run db:start).
# Both values are public (they ship inside the app). NEVER put the service/secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Friends-only test deployment: allow the no-SMS test login (anyone who knows a number can use it).
# Remove before a real launch.
EXPO_PUBLIC_ALLOW_DEV_LOGIN=true
