rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Trainer intro clip (30–60s, length checked in the app)
    function isIntroVideo(file) {
      return file == 'intro.mp4'
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Profile photos + intro video
    match /users/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && (isImage() || isIntroVideo(file));
    }

    // Trainer before/after photos
    match /transformations/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }
  }
}
